{
    "name": "nomadicjosh/vihzhuo",
    "description": "A drag and drop pagebuilder to manage pages in any PHP project.",
    "keywords": [
        "pagebuilder",
        "phppagebuilder",
        "php-pagebuilder",
        "vihzhuo",
        "elementor",
        "divi",
        "beaver-builder"
    ],
    "homepage": "https://github.com/nomadicjosh/vihzhuo",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Joshua Parker",
            "email": "joshua@joshuaparker.dev"
        }
    ],
    "require": {
        "php": ">=8.4",
        "qubus/http": "^4.2",
        "spatie/menu": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "Vihzhuo\\": "src/"
        },
        "files": [
            "src/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Vihzhuo\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "qubus/qubus-coding-standard": "2.1.2",
        "symfony/var-dumper": "^7.4"
    },
    "scripts": {
        "analyse": "phpstan analyse --debug --no-progress --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@analyse",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
